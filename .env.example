# AI Sniper System — 環境変数テンプレート
# 全変数の「目的・既定値・取得元（env / Secrets Manager）・関連§」は
# docs/ai-dev/env-reference.md（目的付きリファレンス表）を参照。
# 平文シークレットはコミットしない（本ファイルはプレースホルダのみ・AGENTS.md #8）。

# ===== リスク管理パラメータ (§4.2) =====
RISK_PERCENT=0.01
MAX_LEVERAGE=10
MIN_RR_RATIO=1.0
# MVP_MODE: 発注数量を 100通貨に固定する（§4.2）。封じ込めとは無関係。
MVP_MODE=True

# ===== 夜型セッション再設計（Ver 3.6・§3.2 / §3.4）=====
# HOLD_HOURS: 保有窓（時間）。ATR_h = ATR14 × √(HOLD_HOURS/24) の分子。
#             20:30 判断 → 翌 4:30 手仕舞いの保有窓 ≈ 8h。
HOLD_HOURS=8
# RD-8 エッジガード day-skip（§3.3 / Issue #194）— IS 由来の初回固定値。再チューニング禁止。
MAX_ATR_DAY_SKIP_PIPS=160
# G1 のみ RD-17（#219）でフォワード実測（GMO 通常スプレッド 0.5 pips 改定）に基づき 0.5 → 1.0 に recalibrate。
MAX_DECISION_SPREAD_PIPS=1.0
# MAX_ENTRY_DISTANCE_ATR: 現値乖離上限。|entry − current_mid| ≤ 係数 × ATR14（§3.4）。
MAX_ENTRY_DISTANCE_ATR=0.3
MIN_SESSION_MOMENTUM_ATR=0.05
# RR_TARGET_DEFAULT: rr_target の既定値（LLM 未出力/範外時）。範囲 1.0〜1.5。
#                    take_profit = entry ± rr_target × |entry − stop_loss| を Python 決定論算出。
RR_TARGET_DEFAULT=1.0

# ===== 実発注の封じ込め (AGENTS.md #1) — two-key interlock =====
# 発注系 POST(ifoOrder/closeOrder/cancelOrders)の実送信は、
# 以下2つを「両方」明示設定したときだけ許可される（単一の設定ミスでは送信されない）。
#   1) ALLOW_LIVE_ORDERS=true（大小非依存・前後空白無視。canonical は小文字
#      — Terraform locals.tf が供給する値に合わせる。Issue #135）
#   2) TRADING_PHASE が 2（Phase 2 実取引）または spike（E06 ドライ疎通）
# 判定は gmo_client.live_orders_allowed() のみ（呼び出し側での独自パース禁止）。
# 既定はいずれも安全側（未送信）。実送信時のみ意図的に設定し、終了後に必ず戻すこと。
ALLOW_LIVE_ORDERS=false
TRADING_PHASE=1

# ===== GMO コイン FX API (§7.2) =====
# ホスト: https://forex-api.coin.z.com
# Public:  /public/v1/...
# Private: /private/v1/...  (署名パスは /v1/... から始める)
# Lambda 本番: Secrets Manager から取得（ALLOW_LOCAL_GMO_CREDENTIALS=true 時のみ下記 env を使用）
ALLOW_LOCAL_GMO_CREDENTIALS=false
GMO_API_KEY=your_api_key_here
GMO_API_SECRET=your_api_secret_here
# Secrets Manager のシークレット名（既定値。変更時のみ設定）
GMO_CREDENTIALS_SECRET_NAME=your-app/gmo-credentials

# ===== LLM API（#16: Anthropic 一本。モデルは差し替え可能） =====
# Lambda 本番: Secrets Manager から取得（ALLOW_LOCAL_ANTHROPIC_KEY=true 時のみ下記 env を使用）
ALLOW_LOCAL_ANTHROPIC_KEY=false
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Secrets Manager のシークレット名（既定値。変更時のみ設定）
ANTHROPIC_SECRET_NAME=your-app/anthropic-api-key
# 判断バッチの意思決定（構造化JSON）/ 手仕舞いノート（散文・E14）
DECISION_MODEL=claude-sonnet-4-6
NIGHT_MODEL=claude-haiku-4-5

# ===== AWS / 永続化 =====
AWS_REGION=ap-northeast-1
# アプリログ/ダッシュボード用 S3 バケット（s3_logger.py が読む env 名は S3_LOG_BUCKET）
S3_LOG_BUCKET=your-log-bucket
# 当日ロック等の DynamoDB テーブル（dynamodb_store.py が読む env 名は DYNAMODB_TABLE）
DYNAMODB_TABLE=your-job-lock-table

# 注: 経済指標ソース（§3.3）は ForexFactory 固定実装（decision_batch が
# ForexFactorySource を直接生成）のため、ソース選択 env は存在しない。
# 差し替えを env 化する場合は別途コード Issue を立てること。

# ===== オーバーナイト米国マクロ補助入力（§3.3, Issue #107 / #142）=====
# ソース選択: yahoo_chart（既定・キー不要・非SLA・httpx 直叩きで依存ゼロ増） /
#            yfinance（後方互換・pandas/numpy 依存追加が必要なため既定から外した #142）/
#            将来の有料ソースに差し替え可
# 取得失敗時はグレースフル・デグレード（NO_ENTRY に倒さない）
MACRO_CONTEXT_SOURCE=yahoo_chart

# ===== 経済指標カレンダー（§3.3 / #210）=====
# ソース選択: forexfactory（既定）。未知値は forexfactory にフォールバック。
ECONOMIC_CALENDAR_SOURCE=forexfactory

# ===== Slack 通知 =====
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# webhook は Secrets Manager から取得する（平文を残さない・AGENTS.md #8）。
# 利用箇所: 監視アラート通知（#105 slack_notifier）と永続化失敗アラート（#140 s3_logger）。
# 本番/staging では out-of-band でこのシークレットに上記 URL の値を投入する。
SLACK_WEBHOOK_SECRET_NAME=your-app/slack-webhook-url
# ローカル開発専用: true のとき slack_notifier / s3_logger が SLACK_WEBHOOK_URL（env）を直接使う。
# 本番では未設定のまま（Secrets Manager 経由に限定）。
ALLOW_LOCAL_SLACK_WEBHOOK=false

# ===== Read API / ダッシュボード =====
# 取引通貨ペア（closeout_batch 等が読む。既定 USD_JPY）
TRADE_SYMBOL=USD_JPY

# ===== ロンドンORBデモ（docs/ai-dev/london-orb-demo-design.md §10）=====
# マスタースイッチ（既定 off）。バッチ配線は ORB-4 以降。
ORB_DEMO_ENABLED=false
ORB_POLL_INTERVAL_SEC=5
# 🔴 中止条件の閾値は **コード上の定数が正**（backend/src/orb/weekly.py・設計書 §9）。
# 以下は可視化のためのミラーで、env から上書きされない。変更は仕様書（結果ノート §9）の
# 改訂を経由すること（勝手にチューニングしない）。
ORB_SLIP_P90_LIMIT=5.84
ORB_SLIP_P50_LIMIT=3.0
ORB_OUTAGE_WEEKLY_LIMIT=2
# セッション状態テーブル（夜型 job-lock とは別・設計書 §6.1）
ORB_DEMO_SESSIONS_TABLE=orb_demo_sessions
# ORB デモは ALLOW_LIVE_ORDERS / TRADING_PHASE / MVP_MODE を参照しない（§3.2）。

# ===== ローカル開発専用の永続化オーバーライド =====
# LocalStack 利用時の AWS エンドポイント（本番では未設定）
# AWS_ENDPOINT_URL=http://localhost:4566
# S3/DynamoDB を使わずローカルファイルに保存するディレクトリ（本番では未設定）
# LOCAL_PERSIST_DIR=./.local-persist
